    <!-- Interactive Workspace Application Logic -->
    <script>
        // Set dynamic credentials (API framework provides keys at runtime environment)
        const apiKey = ""; 

        // Core Application State
        let isDiagnosticMode = false;
        let currentFilter = 'all';
        let activeNodeElement = null;
        let selectedNodeIndex = null;
        let lastAIResponse = null;

        // Base memory configuration map mapped to indices (0 to 95)
        const nodeMap = {
            0: { cat: 'homeland', label: 'Homeland Project', desc: 'Main control node tracking core regional telemetry and perimeter barriers.', dynamicStatus: 'stable' },
            8: { cat: 'zoes-mock-trial', label: "Zoe's Mock Trial", desc: 'Legal virtualization platform conducting synthetic courtroom modeling.', dynamicStatus: 'stable' },
            20: { cat: 'homeland', label: 'Border Encryption Gateway', desc: 'High-security pass-through corridor routing peripheral firewalls.', dynamicStatus: 'anomaly-warning' }
        };

        const grid = document.getElementById('guardianGrid');
        const tooltip = document.getElementById('tooltip');
        const tooltipLabel = document.getElementById('tooltipLabel');
        const tooltipCoordinate = document.getElementById('tooltipCoordinate');
        const systemTerminalLog = document.getElementById('systemTerminalLog');

        // Color theme mapping variables
        const categoryColorMap = {
            'homeland': { text: 'text-blue-400', border: 'border-blue-500/20', bg: 'bg-blue-950/20', badge: 'text-blue-300 border-blue-800 bg-blue-950/60' },
            'zoes-mock-trial': { text: 'text-purple-400', border: 'border-purple-500/20', bg: 'bg-purple-950/20', badge: 'text-purple-300 border-purple-800 bg-purple-950/60' },
            'empty': { text: 'text-neutral-500', border: 'border-neutral-800', bg: 'bg-neutral-950/40', badge: 'text-neutral-400 border-neutral-800 bg-neutral-900/60' }
        };

        // UI Element Selectors
        const detailsCard = document.getElementById('detailsCard');
        const panelCategoryTag = document.getElementById('panelCategoryTag');
        const panelCoords = document.getElementById('panelCoords');
        const panelTitle = document.getElementById('panelTitle');
        const panelDesc = document.getElementById('panelDesc');
        const panelNodeId = document.getElementById('panelNodeId');

        const aiSuggestionBox = document.getElementById('aiSuggestionBox');
        const aiLoader = document.getElementById('aiLoader');
        const aiError = document.getElementById('aiError');
        const aiErrorText = document.getElementById('aiErrorText');
        const aiContent = document.getElementById('aiContent');
        const aiHeaderLabel = document.getElementById('aiHeaderLabel');
        const aiDescriptionLabel = document.getElementById('aiDescriptionLabel');
        const executeAiActionBtn = document.getElementById('executeAiActionBtn');

        // Render standard grid array system
        function buildGrid() {
            grid.innerHTML = '';
            
            for (let i = 0; i < 96; i++) {
                const node = document.createElement('div');
                node.className = 'node h-12 w-full rounded border cursor-pointer flex items-center justify-center text-[10px] font-mono text-neutral-500/50 relative';
                node.dataset.index = i;
                
                // Calculate physical Grid position mappings
                const row = Math.floor(i / 8) + 1;
                const col = (i % 8) + 1;
                node.dataset.coordinate = `R:${row}, C:${col}`;

                // Inject internal layout metadata state rules
                updateNodeRepresentation(node, i);

                // Tooltip Interactions (Coordinates)
                node.onmouseenter = (e) => {
                    tooltip.classList.remove('hidden');
                    const hasMeta = nodeMap[i];
                    tooltipLabel.innerText = hasMeta ? hasMeta.label : 'Empty Architecture Slot';
                    
                    if (hasMeta?.dynamicStatus === 'anomaly-warning') {
                        tooltipLabel.innerText += " (⚠️ Pre-Critical Anomaly)";
                    }
                    tooltipCoordinate.innerText = `[${node.dataset.coordinate}]`;
                };

                node.onmousemove = (e) => {
                    const rect = grid.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    tooltip.style.left = (x + 16) + 'px';
                    tooltip.style.top = (y + 16) + 'px';
                };

                node.onmouseleave = () => {
                    tooltip.classList.add('hidden');
                };

                // Node Selection Interface Triggers
                node.onclick = () => {
                    if (activeNodeElement) activeNodeElement.classList.remove('active', 'ring-2', 'ring-white');
                    
                    node.classList.add('active', 'ring-2', 'ring-white');
                    activeNodeElement = node;
                    selectedNodeIndex = i;

                    handleNodeClick(i, node);
                };

                grid.appendChild(node);
            }
            applyGridFilter(currentFilter);
        }

        function updateNodeRepresentation(node, index) {
            // Remove previous style state classes
            node.className = node.className.replace(/\b(homeland|zoes-mock-trial|empty|predictive-warning|editable-target)\b/g, '').trim();

            const record = nodeMap[index];
            if (record) {
                node.classList.add(record.cat);
                node.innerText = `${index}`;
                node.style.borderWidth = '1px';

                if (isDiagnosticMode && record.dynamicStatus === 'anomaly-warning') {
                    node.classList.add('predictive-warning');
                }
            } else {
                node.classList.add('empty');
                node.innerText = '+';
                
                if (isDiagnosticMode) {
                    node.classList.add('editable-target');
                }
            }
        }

        // Output logger onto the scrolling dashboard console window
        function writeToSystemLog(message, type = 'SYS') {
            const time = new Date().toLocaleTimeString([], { hour12: false });
            const line = document.createElement('div');
            
            if (type === 'ERROR') {
                line.innerHTML = `<span class="text-rose-500">[${time} ${type}] ${message}</span>`;
            } else if (type === 'AI') {
                line.innerHTML = `<span class="text-indigo-400">[${time} ${type}] ${message}</span>`;
            } else if (type === 'WARN') {
                line.innerHTML = `<span class="text-amber-500">[${time} ${type}] ${message}</span>`;
            } else {
                line.innerHTML = `<span class="text-neutral-500">[${time} ${type}] ${message}</span>`;
            }

            systemTerminalLog.appendChild(line);
            systemTerminalLog.scrollTop = systemTerminalLog.scrollHeight;
        }

        // Core dynamic action controller on clicked node targets
        async function handleNodeClick(index, node) {
            const hasRecord = nodeMap[index];
            panelCoords.innerText = `Index #${index} (${node.dataset.coordinate})`;
            panelNodeId.innerText = `BLOCK-ADDR-0X${index.toString(16).toUpperCase().padStart(2, '0')}`;

            // Reset AI box state
            aiSuggestionBox.classList.add('hidden');
            aiLoader.classList.add('hidden');
            aiError.classList.add('hidden');
            aiContent.classList.add('hidden');

            if (isDiagnosticMode) {
                if (!hasRecord) {
                    // Scenario A: Clicked on a Red Flashing Empty Cell (Expansion Opportunity)
                    panelTitle.innerText = "Empty Coordinate Selected";
                    panelTitle.className = "text-lg font-bold text-rose-500";
                    panelDesc.innerText = "System diagnostic signals reveal unallocated space here. Running a prediction to build matching infrastructure extensions...";
                    panelCategoryTag.innerText = "Unassigned Slot";
                    panelCategoryTag.className = "text-[10px] font-bold uppercase tracking-widest text-rose-400";
                    
                    // Fire off generative AI model suggestion
                    triggerGeminiAiAnalysis(index, 'expansion');

                } else if (hasRecord.dynamicStatus === 'anomaly-warning') {
                    // Scenario B: Clicked on a Yellow Flashing Node (Pre-failure Anomaly State)
                    panelTitle.innerText = `${hasRecord.label} - Warning`;
                    panelTitle.className = "text-lg font-bold text-amber-500";
                    panelDesc.innerText = `Warning: High telemetry variances detected. System predicts database lockups or memory fragmentation on block ${index}. Fetching predictive prognosis...`;
                    panelCategoryTag.innerText = "Impending Anomaly";
                    panelCategoryTag.className = "text-[10px] font-bold uppercase tracking-widest text-amber-400";

                    triggerGeminiAiAnalysis(index, 'prognosis');
                } else {
                    // Scenario C: Clicked standard functional node inside diagnostic mode
                    panelTitle.innerText = hasRecord.label;
                    panelTitle.className = "text-lg font-bold text-neutral-100";
                    panelDesc.innerText = hasRecord.desc;
                    panelCategoryTag.innerText = hasRecord.cat.replace('-', ' ');
                    
                    const classes = categoryColorMap[hasRecord.cat] || categoryColorMap['empty'];
                    panelCategoryTag.className = `text-[10px] font-bold uppercase tracking-widest ${classes.text}`;
                }
            } else {
                // View Mode: Static standard click description render
                if (hasRecord) {
                    panelTitle.innerText = recordTitle = hasRecord.label;
                    panelTitle.className = "text-lg font-bold text-neutral-100";
                    panelDesc.innerText = hasRecord.desc;
                    panelCategoryTag.innerText = hasRecord.cat.replace('-', ' ');
                    
                    const classes = categoryColorMap[hasRecord.cat] || categoryColorMap['empty'];
                    panelCategoryTag.className = `text-[10px] font-bold uppercase tracking-widest ${classes.text}`;
                } else {
                    panelTitle.innerText = "Empty Matrix Block";
                    panelTitle.className = "text-lg font-bold text-neutral-400";
                    panelDesc.innerText = "No modules are mapped here yet. Turn on Diagnostic Mode in order to reconstruct system nodes.";
                    panelCategoryTag.innerText = "EMPTY";
                    panelCategoryTag.className = "text-[10px] font-bold uppercase tracking-widest text-neutral-600";
                }
            }
        }

        // --- DYNAMIC LIVE GEMINI RETRY LOGIC & CALLING ---
        async function fetchGeminiCoreSuggestion(prompt, systemPrompt) {
            const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
            
            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "OBJECT",
                        properties: {
                            label: { type: "STRING" },
                            desc: { type: "STRING" },
                            category: { type: "STRING" }, // 'homeland' or 'zoes-mock-trial'
                            prognosisWarning: { type: "STRING" } // ONLY for prognosis type
                        },
                        required: ["label", "desc", "category"]
                    }
                }
            };

            let retryDelay = 1000;
            // Exponential backoff strategy (up to 5 loops)
            for (let attempt = 0; attempt < 5; attempt++) {
                try {
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    
                    if (response.ok) {
                        const json = await response.json();
                        const text = json.candidates?.[0]?.content?.parts?.[0]?.text;
                        return JSON.parse(text);
                    }
                } catch (e) {
                    // Do not log failures to console per instructions
                }
                
                await new Promise(resolve => setTimeout(resolve, retryDelay));
                retryDelay *= 2; // exponential backoff multiplication
            }
            throw new Error("API Connection Timeout. LLM Diagnostic channels disrupted.");
        }

        // Setup prompts context based on adjacent cells coordinates
        async function triggerGeminiAiAnalysis(index, analysisType) {
            aiSuggestionBox.classList.remove('hidden');
            aiLoader.classList.remove('hidden');
            aiError.classList.add('hidden');
            aiContent.classList.add('hidden');

            const row = Math.floor(index / 8) + 1;
            const col = (index % 8) + 1;

            // Compile surrounding data structures
            const leftNode = nodeMap[index - 1] ? `Node to Left is named: ${nodeMap[index - 1].label}, Category: ${nodeMap[index - 1].cat}` : "Left is empty.";
            const rightNode = nodeMap[index + 1] ? `Node to Right is named: ${nodeMap[index + 1].label}, Category: ${nodeMap[index + 1].cat}` : "Right is empty.";
            const topNode = nodeMap[index - 8] ? `Node above is named: ${nodeMap[index - 8].label}, Category: ${nodeMap[index - 8].cat}` : "Above is empty.";
            const bottomNode = nodeMap[index + 8] ? `Node below is named: ${nodeMap[index + 8].label}, Category: ${nodeMap[index + 8].cat}` : "Below is empty.";

            const systemPrompt = `You are "The Guardian" core prognostic neural AI interface. Your task is to output clean valid structured JSON configurations to diagnose or construct a system matrix node.
You must categorize nodes as either "homeland" (focused on safety, perimeter defense, infrastructure, databases, guardrails) or "zoes-mock-trial" (testing virtualizations, legal processes, simulations, dry-runs, system tests).
CRITICAL: If creating a prognosis for a yellow warning cell, the 'prognosisWarning' field MUST start with 'Hey, look!' and explain exactly what technical issue will happen contextually (e.g. database locks, buffer inflation, thread overflow), followed by a clear, tailored recommendation.`;

            let userQuery = "";

            if (analysisType === 'expansion') {
                userQuery = `Recommend a new node creation model configuration for cell #${index} at Row ${row}, Column ${col}.
Surrounding contextual landscape:
- ${leftNode}
- ${rightNode}
- ${topNode}
- ${bottomNode}

Generate a matching, logical category, highly creative network module name (label), and clean technical description (desc) matching the neighbor theme. Use "homeland" or "zoes-mock-trial" for category.`;
            } else {
                const targetNode = nodeMap[index];
                userQuery = `Diagnose a predictive pre-failure warning (Yellow Alert) on cell #${index} (${targetNode.label}, Category: ${targetNode.cat}) at Row ${row}, Column ${col}.
Adjacent nodes landscape:
- ${leftNode}
- ${rightNode}
- ${topNode}
- ${bottomNode}

Generate a 'prognosisWarning' field starting with 'Hey, look!' explaining a theoretical conflict between this cell and its surrounding cells (e.g. resource conflict, packet collisions, loop limits) and recommend a fix. Also output a suggested modified label, modified desc, and keep category as ${targetNode.cat}.`;
            }

            try {
                const aiResult = await fetchGeminiCoreSuggestion(userQuery, systemPrompt);
                
                // Cache results for action buttons
                lastAIResponse = {
                    index: index,
                    type: analysisType,
                    data: aiResult
                };

                // Render dynamic response inside AI panel box
                aiLoader.classList.add('hidden');
                aiContent.classList.remove('hidden');

                if (analysisType === 'expansion') {
                    aiHeaderLabel.innerText = `💡 Recommended Expansion: "${aiResult.label}"`;
                    aiDescriptionLabel.innerHTML = `Our diagnostics suggest a new <strong class="text-indigo-400 font-semibold">${aiResult.category.replace('-', ' ')}</strong> block. <br/><br/><strong>Target Purpose:</strong> ${aiResult.desc}`;
                    executeAiActionBtn.innerText = "Accept AI Architecture";
                    executeAiActionBtn.className = "w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-bold transition flex items-center justify-center gap-2 shadow-lg shadow-indigo-900/30";
                    writeToSystemLog(`Expansion suggestion generated for Block ${index}`, 'AI');
                } else {
                    aiHeaderLabel.innerText = "⚠️ Preemptive Issue Detected";
                    aiDescriptionLabel.innerHTML = `<span class="text-amber-400 font-mono text-[11px] block bg-amber-950/40 p-2 border border-amber-900/50 rounded-md mb-2">${aiResult.prognosisWarning}</span><strong>Resolution:</strong> Accept optimization patch to rewrite block purpose to "${aiResult.label}".`;
                    executeAiActionBtn.innerText = "Deploy Preemptive Optimization Patch";
                    executeAiActionBtn.className = "w-full py-2.5 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-xs font-bold transition flex items-center justify-center gap-2 shadow-lg shadow-amber-950/30";
                    writeToSystemLog(`Preemptive warning anomaly prognosis created for Block ${index}`, 'AI');
                }

            } catch (error) {
                aiLoader.classList.add('hidden');
                aiError.classList.remove('hidden');
                aiErrorText.innerText = error.message;
                writeToSystemLog(`AI predictive engine failure: ${error.message}`, 'ERROR');
            }
        }

        // Apply recommended AI node updates in real-time
        executeAiActionBtn.onclick = () => {
            if (!lastAIResponse) return;

            const { index, type, data } = lastAIResponse;

            if (type === 'expansion') {
                // Commit new cell creation to model map
                nodeMap[index] = {
                    cat: data.category,
                    label: data.label,
                    desc: data.desc,
                    dynamicStatus: 'stable'
                };
                writeToSystemLog(`Allocated block #${index} as [${data.label}]`, 'SYS');
            } else {
                // Apply patches to mitigate anomaly
                nodeMap[index].label = data.label;
                nodeMap[index].desc = data.desc + " [AI Preemptively Patched & Optimized]";
                nodeMap[index].dynamicStatus = 'stable';
                writeToSystemLog(`Resolved anomaly on block #${index} via AI Optimization Patch`, 'SYS');
            }

            // Hide suggestions panel and re-render grid
            aiSuggestionBox.classList.add('hidden');
            
            // Re-render targets
            updateNodeRepresentation(activeNodeElement, index);
            createGridNodeRefresh();

            // Refresh Detail Panels
            handleNodeClick(index, activeNodeElement);
            lastAIResponse = null;
        };

        // Complete Grid Refresh Loop
        function createGridNodeRefresh() {
            const nodes = grid.querySelectorAll('.node');
            nodes.forEach(node => {
                const idx = parseInt(node.dataset.index);
                updateNodeRepresentation(node, idx);
            });
            applyGridFilter(currentFilter);
        }

        // Grid filters layout engine
        function applyGridFilter(filterType) {
            currentFilter = filterType;
            const nodes = grid.querySelectorAll('.node');

            nodes.forEach(node => {
                node.classList.remove('dimmed', 'opacity-20');
                const index = parseInt(node.dataset.index);
                const hasRecord = nodeMap[index];

                if (filterType === 'homeland') {
                    if (!hasRecord || hasRecord.cat !== 'homeland') node.classList.add('dimmed', 'opacity-20');
                } else if (filterType === 'zoes-mock-trial') {
                    if (!hasRecord || hasRecord.cat !== 'zoes-mock-trial') node.classList.add('dimmed', 'opacity-20');
                } else if (filterType === 'empty') {
                    if (hasRecord) node.classList.add('dimmed', 'opacity-20');
                }
            });
        }

        // --- FILTER BUTTON INTERACTION HANDLERS ---
        filterBtns.forEach(btn => {
            btn.onclick = () => {
                filterBtns.forEach(b => {
                    b.classList.remove('bg-neutral-100', 'text-neutral-950', 'font-bold');
                    b.classList.add('bg-neutral-800', 'text-neutral-300');
                });
                btn.classList.remove('bg-neutral-800', 'text-neutral-300');
                btn.classList.add('bg-neutral-100', 'text-neutral-950', 'font-bold');

                applyGridFilter(btn.dataset.filter);
            };
        });

        // Toggle diagnostics and trigger UI animations
        const toggleDiagnosticBtn = document.getElementById('toggleDiagnosticBtn');
        const diagnosticIndicator = document.getElementById('diagnosticIndicator');
        const diagnosticStatusText = document.getElementById('diagnosticStatusText');

        toggleDiagnosticBtn.onclick = () => {
            isDiagnosticMode = !isDiagnosticMode;
            aiSuggestionBox.classList.add('hidden');

            if (isDiagnosticMode) {
                toggleDiagnosticBtn.classList.add('bg-rose-950/20', 'text-rose-400', 'border-rose-800');
                toggleDiagnosticBtn.classList.remove('bg-neutral-800', 'text-neutral-300');
                diagnosticIndicator.classList.remove('bg-neutral-500');
                diagnosticIndicator.classList.add('bg-rose-500', 'animate-ping');
                diagnosticStatusText.innerText = "Active";
                diagnosticStatusText.className = "text-[10px] font-bold text-rose-500 uppercase tracking-widest";
                writeToSystemLog("Diagnostics scan sweep enabled.", "WARN");
            } else {
                toggleDiagnosticBtn.classList.remove('bg-rose-950/20', 'text-rose-400', 'border-rose-800');
                toggleDiagnosticBtn.classList.add('bg-neutral-800', 'text-neutral-300');
                diagnosticIndicator.classList.add('bg-neutral-500');
                diagnosticIndicator.classList.remove('bg-rose-500', 'animate-ping');
                diagnosticStatusText.innerText = "Off";
                diagnosticStatusText.className = "text-[10px] font-bold text-neutral-500 uppercase tracking-widest";
                writeToSystemLog("Diagnostics console disabled.", "SYS");
            }

            createGridNodeRefresh();

            // Refresh current selected node states
            if (selectedNodeIndex !== null) {
                handleNodeClick(selectedNodeIndex, activeNodeElement);
            }
        };

        // Anomaly Injections Simulator Trigger
        const simulateAnomalyBtn = document.getElementById('simulateAnomalyBtn');
        simulateAnomalyBtn.onclick = () => {
            // Find active stable blocks
            const activeIndices = Object.keys(nodeMap).filter(idx => nodeMap[idx].dynamicStatus !== 'anomaly-warning');
            
            if (activeIndices.length === 0) {
                writeToSystemLog("Injection failed: No active healthy nodes available.", "ERROR");
                return;
            }

            // Randomly degrade an active block
            const randomIndex = activeIndices[Math.floor(Math.random() * activeIndices.length)];
            nodeMap[randomIndex].dynamicStatus = 'anomaly-warning';

            writeToSystemLog(`WARNING: Grid Anomaly detected at node #${randomIndex}. Preemptive system degradation expected.`, "WARN");
            
            createGridNodeRefresh();
            
            // Automatically prompt details on injected node if currently selected
            if (parseInt(selectedNodeIndex) === parseInt(randomIndex)) {
                handleNodeClick(selectedNodeIndex, activeNodeElement);
            }
        };

        // Clear log script
        document.getElementById('clearLogBtn').onclick = () => {
            systemTerminalLog.innerHTML = '<div>[SYS] Central matrix telemetry cleared.</div>';
        };

        // Initialize grid on run
        buildGrid();
    </script>
</body>
</html>

