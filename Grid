    <title>The Guardian - Predictive AI Workspace</title>
    <!-- Tailwind CSS for high-fidelity styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Pulse Red Keyframes for Empty/Unconfigured Nodes */
        @keyframes pulseRedAlert {
            0% { box-shadow: inset 0 0 2px #ef4444; }
            50% { background-color: #7f1d1d; box-shadow: inset 0 0 14px #ef4444; border-color: #f87171; }
            100% { box-shadow: inset 0 0 2px #ef4444; }
        }
        .node.editable-target {
            animation: pulseRedAlert 1.6s infinite ease-in-out;
            border: 1px dashed #ef4444;
        }
        .node.editable-target:hover {
            animation: none;
            background-color: #b91c1c;
            border: 2px solid #ffffff;
        }

        /* Pulse Yellow Keyframes for Impending Anomaly Pre-Failure Nodes */
        @keyframes pulseYellowWarning {
            0% { box-shadow: 0 0 2px #eab308; }
            50% { box-shadow: 0 0 16px #facc15; border: 2px solid #fef08a; background-color: #854d0e; }
            100% { box-shadow: 0 0 2px #eab308; }
        }
        .node.predictive-warning {
            animation: pulseYellowWarning 2s infinite ease-in-out;
        }

        /* Grid Node Hover Effects */
        .node {
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s, border-color 0.2s;
        }
        .node:hover {
            transform: scale(1.15) z-index(10);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
        }

        /* Standard Categories styling */
        .node.homeland { background-color: #3b82f6; border-color: #60a5fa; }
        .node.zoes-mock-trial { background-color: #a855f7; border-color: #c084fc; }
        .node.empty { background-color: #374151; border-color: #4b5563; }

        /* Smooth scrollbar styling */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #1f2937; }
        ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 3px; }
    </style>
</head>
