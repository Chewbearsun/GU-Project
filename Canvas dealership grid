<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        .grid-container { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; max-width: 900px; margin: 20px auto; }
        .node { aspect-ratio: 1; background: #333; border: 1px solid #555; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 0.5em; cursor: pointer; transition: all 0.3s; color: white; text-align: center; border-radius: 4px; padding: 2px; }
        .zone-1 { border-top: 3px solid #3498db; }
        .zone-2 { border-top: 3px solid #e67e22; }
        .zone-3 { border-top: 3px solid #9b59b6; }
        .status-alert { background: #e74c3c; }
        .status-healthy { background: #27ae60; }
    </style>
</head>
<body>
    <div class="grid-container" id="grid"></div>
    <script>
        const grid = document.getElementById('grid');
        const labels = {
            "1-1": "Inv. Age", "1-2": "Stock In", "1-3": "Lead Vol.", "1-4": "Shop Backlog",
            "2-1": "Acq. Cost", "2-2": "Lot Space", "2-3": "Test Drives", "2-4": "Recon Time"
        };
        
        for(let i=0; i<96; i++) {
            let r = Math.floor(i/12) + 1;
            let c = (i%12) + 1;
            let div = document.createElement('div');
            div.className = `node ${c===2?'zone-1':''} ${c===3?'zone-2':''} ${c===4?'zone-3':''}`;
            div.innerText = labels[`${r}-${c}`] || `${r}-${c}`;
            div.onclick = () => div.classList.toggle('status-alert');
            grid.appendChild(div);
        }
    </script>
</body>
</html>

